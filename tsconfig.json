{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"./.svelte-kit/types/**/$types.d.ts",
		"./vite.config.ts",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte"
	],
	"exclude": ["./node_modules/**", "./[!ambient.d.ts]**"]
}
